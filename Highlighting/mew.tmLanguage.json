{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mew",
  "scopeName": "source.mew",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.mew",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.mew",
          "match": "//.*$"
        },
        {
          "name": "comment.block.mew",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.mew",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mew",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "name": "constant.character.escape.mew",
              "match": "\\\\(?:[0abfnrtv\\\\'\"]|u[0-9a-fA-F]{4})"
            },
            {
              "name": "meta.interpolation.mew",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.interpolation.begin.mew"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.interpolation.end.mew"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.mew",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mew",
              "match": "\\\\(?:[0abfnrtv\\\\'\"]|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.mew",
          "match": "'(?:\\\\(?:[0abfnrtv\\\\'\"]|u[0-9a-fA-F]{4})|[^'\\\\])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.mew",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.float.mew",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.mew",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.mew",
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.attribute.begin.mew"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.attribute.end.mew"
            }
          },
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mew",
          "match": "\\b(if|else|loop|while|break|continue|return|in|for|match)\\b"
        },
        {
          "name": "keyword.other.mew",
          "match": "\\b(fn|let|mut|type|union|field|namespace|use|new|self|interface|impl)\\b"
        },
        {
          "name": "storage.modifier.mew",
          "match": "\\b(pub|static|external)\\b"
        },
        {
          "name": "keyword.operator.word.mew",
          "match": "\\b(as|is)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.mew",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.mew",
          "match": "\\b(null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.mew",
          "match": "\\b(bool|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|char|string|void|any|int)\\b"
        },
        {
          "match": "(?<=:\\s|->\\s?)([A-Z][a-zA-Z0-9]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.mew"
            }
          }
        },
        {
          "match": "(?<=\\btype\\s)([A-Z][a-zA-Z0-9]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.mew"
            }
          }
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "comment": "Function call - identifier followed by (",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.mew"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.mew",
          "match": "->|=>|&&|\\|\\||==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|[+\\-*/%=<>!]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.mew",
          "match": "[;,.]"
        },
        {
          "name": "punctuation.section.braces.begin.mew",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.mew",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.parens.begin.mew",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.mew",
          "match": "\\)"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "meta.preprocessor.mew",
          "begin": "^\\s*(#load)\\b",
          "end": "$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.mew"
            }
          },
          "patterns": [
            {
              "include": "#strings"
            }
          ]
        }
      ]
    }
  }
}
